/* Diseño general */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f4f6f9;
    color: #333;
    line-height: 1.6;
}

/* Encabezado */
header {
    background-color: #0b3d66;
    color: white;
    text-align: center;
    padding: 30px 20px;
}

header h1 {
    font-size: 32px;
    margin-bottom: 10px;
}

/* Menú de navegación */
nav {
    background-color: #082b49;
    padding: 15px;
    text-align: center;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 15px;
    font-weight: bold;
}

nav a:hover {
    color: #83b81a;
}

/* Contenido principal */
main {
    max-width: 1000px;
    margin: 30px auto;
    padding: 20px;
}

section {
    background-color: white;
    padding: 25px;
    margin-bottom: 25px;
    border-radius: 10px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
}

h2 {
    color: #0b3d66;
    margin-bottom: 15px;
}

p {
    margin-bottom: 12px;
}

/* Imágenes */
img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
}

/* Botones y enlaces */
button {
    background-color: #83b81a;
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: 6px;
    cursor: pointer;
}

button:hover {
    background-color: #689414;
}

/* Pie de página */
footer {
    background-color: #082b49;
    color: white;
    text-align: center;
    padding: 20px;
    margin-top: 30px;
}

/* Adaptación a celulares */
@media (max-width: 600px) {
    header h1 {
        font-size: 24px;
    }

    nav a {
        display: block;
        margin: 10px 0;
    }

    main {
        padding: 12px;
    }
}
